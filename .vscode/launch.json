{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch App (src/index.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/index.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run All Tests",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/tests/greeting.test.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Health Check Diagnostics",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/scripts/health-check.js"
    }
  ]
}
